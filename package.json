{
  "name": "protocolcanary-action",
  "version": "0.1.1",
  "private": true,
  "description": "Official GitHub Actions integration for Stellar Protocol Canary.",
  "homepage": "https://github.com/StellarCanary/ProtocolCanary-Action#readme",
  "bugs": {
    "url": "https://github.com/StellarCanary/ProtocolCanary-Action/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellarCanary/ProtocolCanary-Action.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:root": "node scripts/check-root-files.mjs",
    "lint": "eslint src tests",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.4",
    "yaml": "2.9.1"
  }
}
